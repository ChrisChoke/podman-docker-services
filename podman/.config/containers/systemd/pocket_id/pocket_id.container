[Service]
EnvironmentFile=%h/.config/containers/systemd/.env
Restart=always

[Container]
Image=ghcr.io/pocket-id/pocket-id:v2
ContainerName=pocket-id
PublishPort=1411:1411
#Network=frontend.network
Volume=./pocket-id:/app/data:Z

Environment=TZ=Europe/Amsterdam
Environment=APP_URL=https://auth.${BASEDOMAIN}
# Encryption key. Generate with: openssl rand -base64 32
# Put the base64 key in a file and point to it here.
Environment=ENCRYPTION_KEY_FILE=/app/data/encryption.key

# These variables are optional but recommended to review:
Environment=TRUST_PROXY=192.168.1.1
#Environment=MAXMIND_LICENSE_KEY=

#Label="traefik.enable=true"
#Label="traefik.http.routers.pocketid.entrypoints=websecure"
#Label="traefik.http.routers.pocketid.rule=Host(`auth.${BASEDOMAIN}`)"
#Label="traefik.http.routers.pocketid.tls=true"
#Label="traefik.http.services.pocketid.loadbalancer.server.port=1411"

[Install]
# Start by default on boot
WantedBy=default.target