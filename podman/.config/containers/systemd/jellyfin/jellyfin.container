[Service]
EnvironmentFile=%h/.config/containers/systemd/.env
# Inform systemd of additional exit status
SuccessExitStatus=0 143

[Container]
Image=docker.io/jellyfin/jellyfin:latest
ContainerName=jellyfin
Network=frontend.network
Volume=./config:/config
Volume=./cache:/cache
Volume=/mnt/plex_media:/media:Z
UserNS=keep-id

#Environment=PUID=1000
#Environment=PGID=1000
Environment=TZ=Europe/Amsterdam
Environment=JELLYFIN_PublishedServerUrl=https://jellyfin.${BASEDOMAIN}

Label="traefik.enable=true"
Label="traefik.http.routers.jellyfin.entrypoints=websecure"
Label="traefik.http.routers.jellyfin.rule=Host(`jellyfin.${BASEDOMAIN}`)"
Label="traefik.http.routers.jellyfin.tls=true"
Label="traefik.http.services.jellyfin.loadbalancer.server.port=8096"
# udp routing
Label="traefik.udp.routers.jellyfin-discovery.entrypoints=udp-jf" # reference from traefik.yml static config
Label="traefik.udp.services.jellyfin-discovery.loadbalancer.server.port=7359"

[Install]
# Start by default on boot
WantedBy=default.target